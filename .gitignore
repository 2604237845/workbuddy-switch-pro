# tasks/ —— 任务中心（Python）的运行时数据，一律不入库
# ---------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# 引擎层运行时
tasks/engine/backups/
# 夜猫子「本夜已计过」状态（首次确认到账后才会生成）
tasks/engine/config/black_cat_nights.json
# 🔴 真 access token：桌面客户端登录成功后由上游脚本写入
tasks/engine/vendor/WORKBUDDY_ACCESS_TOKEN.txt

# 服务层运行时（server.pid / server.log 都在这）
tasks/service/_private/
# 定时计划：首次启动按 server.py 的 DEFAULT_SCHEDULE 生成，各人可能不同，不入库
tasks/service/config/schedule.json

